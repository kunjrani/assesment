# Optional — Stages 2–4 work without a key (local embeddings + you can mock LLM later)
OPENAI_API_KEY=

# auto = OpenAI if key set, else free local embeddings (recommended for assessment)
EMBEDDING_BACKEND=auto

# auto = OpenAI if key set, else mock grounded draft (no payment needed)
LLM_BACKEND=auto

# Windows only — uncomment if Tesseract/Poppler are not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin

MIN_PAGE_TEXT_CHARS=40
OCR_DPI=200
